# Copy this file to .env and fill it in yourself. Never commit .env or paste keys in chat.

# PayPal sandbox app keys (free): developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The app refuses any address that is not the PayPal sandbox.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Test customers receive sandbox notices here. Use your sandbox personal account email.
SANDBOX_BUYER_EMAIL=

# Free local AI through Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Set to true if you have only a small graphics card. It can be much faster.
AI_CPU_ONLY=false

# Local database file
DATABASE_URL=sqlite:///data/paidloop.db
